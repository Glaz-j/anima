# 仅用于 pi-agent-core 教学示例。复制为 .env 后填写，再运行 npm run example:pi -- --live。
# provider 和 model 必须是当前安装版本的 pi-ai 内置目录中的组合。
PI_EXAMPLE_PROVIDER=anthropic
PI_EXAMPLE_MODEL=claude-sonnet-4-6
PI_EXAMPLE_API_KEY=

# 可选：覆盖模型的 API 地址；该地址需兼容所选模型的 API 协议。
# PI_EXAMPLE_BASE_URL=https://your-gateway.example

# 角色会客室：npm run chat
# 不设置下面的密钥时，尝试只读复用 ~/.pi/agent/models.json 和 auth.json。
# 配置自定义 OpenAI-compatible 接口时，填 API、provider、model、base URL 和 key。
# ANIMA_API=openai-completions
# ANIMA_PROVIDER=my-provider
# ANIMA_MODEL=my-model
# ANIMA_BASE_URL=https://your-gateway.example/v1
# ANIMA_API_KEY=
# ANIMA_PI_PROVIDER=my-existing-pi-provider
# ANIMA_PORT=18790

# 本地 EasyCLIProxyAPI（角色会客室与 Minecraft 共用 loadModel）。
# 需要同时填写以下配置；仅启动代理不会自动替换现有 pi provider。
# ANIMA_API=openai-completions
# ANIMA_PROVIDER=easycliproxy
# ANIMA_MODEL=gpt-6-luna
# ANIMA_BASE_URL=http://127.0.0.1:8317/v1
# ANIMA_API_KEY=填写代理中配置的本地访问密钥

# Minecraft 本机四 NPC 完整生存：npm run minecraft:up（默认 survival）
# ANIMA_MC_API_PORT=18791
# 实时观察共用一个本地端口；默认 API 端口加一。
# ANIMA_MC_VIEWER_PORT=18792
# ANIMA_MC_HOST=127.0.0.1
# ANIMA_MC_PORT=25565
# ANIMA_MC_VERSION=1.21.4
# 单个 NPC 可只覆盖模型 ID，复用上面的接口和密钥；其余角色继续使用 ANIMA_MODEL。
# 配置名使用角色名称大写，例如 HuYifei → HUYIFEI；取消这一行即可恢复默认。
# ANIMA_MC_MODEL_HUYIFEI=gpt-6.1-sol
# 不指定 token 时，每次启动生成新的本地会话 token。
# ANIMA_MC_API_TOKEN=

# 四 NPC 随机世界完整生存（独立存档）：minecraft:up、minecraft:start 默认使用此模式；也可显式 npm run minecraft:survival。
# 默认准备完毕后持续调用模型；false 仅准备世界，在控制台点击开始。
# ANIMA_MC_AUTORUN=true
# 可显式选择模式；命令行 --survival / --dragon 优先于此环境变量。
# ANIMA_MC_SCENARIO=survival
# 旧双人沙盒诊断需显式 ANIMA_MC_SCENARIO=sandbox（有开局物品、固定白天，不计入完整生存）。
# 直接进入末地的历史诊断场景单独使用 npm run minecraft:dragon，不代表完整生存目标。
